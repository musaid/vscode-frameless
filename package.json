{
  "name": "frameless",
  "displayName": "Frameless",
  "description": "Hide the title bar on macOS and put the traffic lights next to your tabs.",
  "version": "0.2.1",
  "publisher": "musaid",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#282c34",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/musaid/vscode-frameless"
  },
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "titlebar",
    "traffic lights",
    "frameless",
    "macos"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "frameless.apply",
        "title": "Frameless: Apply"
      },
      {
        "command": "frameless.restore",
        "title": "Frameless: Restore VS Code files"
      }
    ],
    "configuration": {
      "title": "Frameless",
      "properties": {
        "frameless.trafficLights": {
          "type": "object",
          "default": {
            "x": 10,
            "y": 14
          },
          "properties": {
            "x": {
              "type": "number",
              "description": "Distance from the left edge."
            },
            "y": {
              "type": "number",
              "description": "Distance from the top edge. 14 centres them on the tab bar."
            }
          },
          "additionalProperties": false,
          "description": "Where the traffic lights sit, in points from the top-left corner.",
          "scope": "application"
        },
        "frameless.stylesheet": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Your own CSS file, applied to the whole window. `~/` works. Run **Frameless: Apply** after you edit it."
        },
        "frameless.watermark": {
          "type": "string",
          "default": "",
          "markdownDescription": "An image for the empty editor: SVG, PNG, JPG or WebP. `~/` works. Leave empty for the default.",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/renderer/tsconfig.json --noEmit",
    "package": "pnpm build && vsce package --no-dependencies",
    "vscode:uninstall": "node ./dist/uninstall.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
